<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ Name or "Portfolio" }} — Personal Portfolio</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <style>
        /* ====== THEME TOKENS — supports dark (default) and light ====== */
        :root[data-theme="dark"] {
            --bg-page:        #0b0a1a;
            --bg-section:     rgba(255, 255, 255, 0.04);
            --text-primary:   #ffffff;
            --text-secondary: rgba(255, 255, 255, 0.78);
            --text-muted:     rgba(255, 255, 255, 0.55);
            --card-bg:        rgba(255, 255, 255, 0.05);
            --card-border:    rgba(255, 255, 255, 0.12);
            --card-shadow:    0 10px 30px rgba(0, 0, 0, 0.35);
            --nav-bg:         rgba(15, 12, 35, 0.72);
            --gradient-1:     linear-gradient(135deg, #8a2be2 0%, #4b0082 50%, #6a5acd 100%);
            --gradient-soft:  linear-gradient(135deg, #2a1b5e 0%, #0b0a1a 100%);
            --accent:         #a78bfa;
            --accent-2:       #7c3aed;
            --contact-gradient: linear-gradient(135deg, #2a1b5e 0%, #0b0a1a 100%);
            --form-input-bg:  rgba(255, 255, 255, 0.06);
            --form-input-fg:  #ffffff;
            --footer-bg:      rgba(0, 0, 0, 0.35);
            --code-color-1:   rgba(167, 139, 250, 0.55);
            --code-color-2:   rgba(124, 58, 237, 0.6);
            --code-color-3:   rgba(196, 181, 253, 0.65);
        }
        :root[data-theme="light"] {
            --bg-page:        #f6f4ff;
            --bg-section:     rgba(255, 255, 255, 0.75);
            --text-primary:   #1a1437;
            --text-secondary: #3d2f6b;
            --text-muted:     #6a5a96;
            --card-bg:        rgba(255, 255, 255, 0.85);
            --card-border:    rgba(124, 58, 237, 0.18);
            --card-shadow:    0 12px 32px rgba(124, 58, 237, 0.12);
            --nav-bg:         rgba(255, 255, 255, 0.85);
            --gradient-1:     linear-gradient(135deg, #8a2be2 0%, #4b0082 50%, #6a5acd 100%);
            --gradient-soft:  linear-gradient(135deg, #ede9fe 0%, #ddd6fe 100%);
            --accent:         #6d28d9;
            --accent-2:       #5b21b6;
            --contact-gradient: linear-gradient(135deg, #8a2be2 0%, #4b0082 100%);
            --form-input-bg:  rgba(255, 255, 255, 0.95);
            --form-input-fg:  #1a1437;
            --footer-bg:      rgba(237, 233, 254, 0.85);
            --code-color-1:   rgba(124, 58, 237, 0.45);
            --code-color-2:   rgba(109, 40, 217, 0.55);
            --code-color-3:   rgba(91, 33, 182, 0.55);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html { scroll-behavior: smooth; }

        body {
            font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
            line-height: 1.65;
            color: var(--text-secondary);
            background: var(--bg-page);
            overflow-x: hidden;
            transition: background 0.4s ease, color 0.4s ease;
        }

        /* ====== 3D Animated Code Background ====== */
        .bg-animation {
            position: fixed;
            inset: 0;
            z-index: -2;
            overflow: hidden;
            background: var(--gradient-soft);
            transition: background 0.4s ease;
        }

        .floating-element {
            position: absolute;
            font-family: 'JetBrains Mono', 'Courier New', monospace;
            font-weight: 600;
            user-select: none;
            pointer-events: none;
            animation: float 35s linear infinite;
            text-shadow: 0 0 12px var(--code-color-1);
            transition: color 0.4s ease, text-shadow 0.4s ease;
        }
        .binary    { font-size: 26px; color: var(--code-color-2); font-weight: 700; }
        .number    { font-size: 24px; color: var(--code-color-1); }
        .bracket   { font-size: 36px; color: var(--code-color-3); }
        .keyword   { font-size: 22px; color: var(--code-color-2); font-weight: 700; }
        .variable  { font-size: 20px; color: var(--code-color-1); font-style: italic; }
        .code-sym  { font-size: 28px; color: var(--code-color-3); }

        @keyframes float {
            0%   { transform: translateY(110vh) rotate(0deg)   scale(0.85); opacity: 0; }
            8%   { opacity: 1; }
            50%  { transform: translateY(50vh)  rotate(180deg) scale(1.05); opacity: 0.85; }
            92%  { opacity: 1; }
            100% { transform: translateY(-120px) rotate(360deg) scale(0.85); opacity: 0; }
        }

        /* ====== Navigation ====== */
        nav {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 1000;
            background: var(--nav-bg);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border-bottom: 1px solid var(--card-border);
            transition: background 0.4s ease, border-color 0.4s ease;
        }
        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
            height: 70px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .logo {
            font-size: 1.5rem;
            font-weight: 800;
            font-family: 'Space Grotesk', sans-serif;
            background: var(--gradient-1);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .nav-links {
            display: flex;
            list-style: none;
            gap: 2.2rem;
            align-items: center;
        }
        .nav-links a {
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 500;
            position: relative;
            transition: color 0.25s;
        }
        .nav-links a:hover { color: var(--accent); }
        .nav-links a::after {
            content: '';
            position: absolute;
            left: 0; bottom: -6px;
            width: 0; height: 2px;
            background: var(--gradient-1);
            transition: width 0.3s;
        }
        .nav-links a:hover::after { width: 100%; }

        .nav-actions { display: flex; gap: 0.6rem; align-items: center; }

        .theme-toggle {
            width: 40px; height: 40px;
            border-radius: 50%;
            border: 1px solid var(--card-border);
            background: var(--card-bg);
            color: var(--text-primary);
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: all 0.25s;
        }
        .theme-toggle:hover { transform: scale(1.07); color: var(--accent); border-color: var(--accent); }
        .theme-toggle .fa-sun  { display: none; }
        :root[data-theme="light"] .theme-toggle .fa-sun   { display: inline; }
        :root[data-theme="light"] .theme-toggle .fa-moon  { display: none; }

        .menu-btn {
            display: none;
            background: none;
            border: none;
            color: var(--text-primary);
            font-size: 1.4rem;
            cursor: pointer;
        }

        /* ====== Hero ====== */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 110px 2rem 60px;
            position: relative;
            text-align: center;
        }
        .hero-content { max-width: 820px; z-index: 5; }
        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 16px;
            border-radius: 999px;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            color: var(--accent);
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 1.4rem;
            backdrop-filter: blur(8px);
        }
        .hero-eyebrow .dot {
            width: 8px; height: 8px; border-radius: 50%;
            background: #10b981; box-shadow: 0 0 10px #10b981;
            animation: pulse 1.6s infinite;
        }
        @keyframes pulse {
            0%, 100% { transform: scale(1);   opacity: 1; }
            50%      { transform: scale(1.4); opacity: 0.6; }
        }
        .hero h1 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: clamp(2.6rem, 6vw, 4.5rem);
            font-weight: 700;
            line-height: 1.1;
            margin-bottom: 1rem;
            color: var(--text-primary);
        }
        .hero h1 .accent-text {
            background: var(--gradient-1);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .hero h2 {
            font-size: clamp(1.1rem, 2.5vw, 1.6rem);
            font-weight: 500;
            color: var(--text-muted);
            margin-bottom: 1.4rem;
        }
        .hero p.bio {
            font-size: 1.1rem;
            color: var(--text-secondary);
            max-width: 640px;
            margin: 0 auto 2.2rem;
            line-height: 1.8;
        }
        .hero-buttons {
            display: flex; gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 2.4rem;
        }
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 14px 32px;
            border-radius: 999px;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.25s;
        }
        .btn-primary {
            background: var(--gradient-1);
            color: #fff;
            box-shadow: 0 6px 22px rgba(138, 43, 226, 0.35);
        }
        .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(138, 43, 226, 0.5); }
        .btn-outline {
            background: transparent;
            color: var(--accent);
            border-color: var(--accent);
        }
        .btn-outline:hover {
            background: var(--accent);
            color: #fff;
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(124, 58, 237, 0.4);
        }

        .hero-socials { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; }
        .hero-socials a {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 10px 20px;
            border-radius: 999px;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            color: var(--text-primary);
            text-decoration: none;
            font-weight: 500;
            backdrop-filter: blur(8px);
            transition: all 0.25s;
        }
        .hero-socials a:hover {
            transform: translateY(-2px);
            border-color: var(--accent);
            color: var(--accent);
            box-shadow: 0 6px 20px rgba(124, 58, 237, 0.25);
        }

        /* ====== Sections ====== */
        .section {
            padding: 100px 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }
        .section-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: clamp(2rem, 4vw, 2.6rem);
            font-weight: 700;
            text-align: center;
            margin-bottom: 3rem;
            background: var(--gradient-1);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* ====== About ====== */
        .about-card {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 2.5rem;
            background: var(--card-bg);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid var(--card-border);
            border-radius: 22px;
            padding: 3rem;
            box-shadow: var(--card-shadow);
        }
        .about-text h3 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.6rem;
            color: var(--text-primary);
            margin-bottom: 1rem;
        }
        .about-text p { margin-bottom: 1rem; font-size: 1.05rem; line-height: 1.8; }
        .edu-card {
            background: var(--gradient-1);
            color: #fff;
            border-radius: 18px;
            padding: 2.2rem;
            box-shadow: 0 10px 30px rgba(138, 43, 226, 0.35);
        }
        .edu-card h3 { color: #fff; margin-bottom: 1rem; font-size: 1.4rem; font-family: 'Space Grotesk', sans-serif; }
        .edu-card p { color: rgba(255,255,255,0.95); margin-bottom: 0.5rem; }
        .edu-card .meta {
            margin-top: 1.2rem;
            padding-top: 1.2rem;
            border-top: 1px solid rgba(255,255,255,0.25);
            font-size: 0.9rem;
        }

        /* ====== Skills ====== */
        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1.6rem;
        }
        .skill-card {
            background: var(--card-bg);
            backdrop-filter: blur(10px);
            border: 1px solid var(--card-border);
            border-radius: 18px;
            padding: 2rem;
            text-align: center;
            transition: all 0.3s;
            box-shadow: var(--card-shadow);
        }
        .skill-card:hover {
            transform: translateY(-8px);
            border-color: var(--accent);
            box-shadow: 0 18px 40px rgba(124, 58, 237, 0.3);
        }
        .skill-card .icon {
            font-size: 2.6rem;
            background: var(--gradient-1);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 1rem;
        }
        .skill-card h3 { color: var(--text-primary); margin-bottom: 0.6rem; font-size: 1.2rem; }
        .skill-card p  { color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; }

        .skill-pills { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: center; }
        .skill-pill {
            padding: 0.55rem 1.1rem;
            border-radius: 999px;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            color: var(--text-primary);
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.2s;
        }
        .skill-pill:hover { border-color: var(--accent); color: var(--accent); }

        /* ====== Experience ====== */
        .timeline { position: relative; padding-left: 30px; }
        .timeline::before {
            content: ''; position: absolute; left: 6px; top: 6px; bottom: 6px;
            width: 2px; background: var(--gradient-1);
        }
        .timeline-item {
            position: relative;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 1.6rem 1.8rem;
            margin-bottom: 1.4rem;
            backdrop-filter: blur(10px);
            box-shadow: var(--card-shadow);
        }
        .timeline-item::before {
            content: ''; position: absolute;
            left: -32px; top: 28px;
            width: 14px; height: 14px;
            border-radius: 50%;
            background: var(--gradient-1);
            box-shadow: 0 0 12px var(--accent);
        }
        .timeline-item h4 { color: var(--text-primary); font-size: 1.2rem; margin-bottom: 0.2rem; }
        .timeline-item .company { color: var(--accent); font-weight: 600; margin-bottom: 0.3rem; }
        .timeline-item .dates   { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.6rem; }
        .timeline-item p        { color: var(--text-secondary); font-size: 0.95rem; }

        /* ====== Projects ====== */
        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
            gap: 1.8rem;
        }
        .project-card {
            background: var(--card-bg);
            backdrop-filter: blur(12px);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 2rem;
            transition: all 0.3s;
            display: flex;
            flex-direction: column;
            box-shadow: var(--card-shadow);
        }
        .project-card:hover {
            transform: translateY(-8px);
            border-color: var(--accent);
            box-shadow: 0 22px 44px rgba(124, 58, 237, 0.3);
        }
        .project-card h3 {
            font-family: 'Space Grotesk', sans-serif;
            color: var(--text-primary);
            font-size: 1.35rem;
            margin-bottom: 0.7rem;
        }
        .project-card p { color: var(--text-secondary); margin-bottom: 1rem; line-height: 1.65; font-size: 0.95rem; }
        .project-card ul { list-style: none; margin-bottom: 1.2rem; }
        .project-card ul li {
            position: relative;
            padding-left: 22px;
            color: var(--text-secondary);
            margin-bottom: 0.4rem;
            font-size: 0.92rem;
            line-height: 1.55;
        }
        .project-card ul li::before {
            content: '✦';
            position: absolute;
            left: 0;
            color: var(--accent);
            font-size: 0.85rem;
        }
        .tech-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.2rem; }
        .tech-tag {
            padding: 0.4rem 0.95rem;
            border-radius: 999px;
            background: var(--gradient-1);
            color: #fff;
            font-size: 0.8rem;
            font-weight: 600;
        }
        .project-links { display: flex; gap: 0.7rem; flex-wrap: wrap; margin-top: auto; }
        .project-link {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.55rem 1.1rem;
            border-radius: 999px;
            background: var(--gradient-1);
            color: #fff;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.88rem;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .project-link:hover { transform: translateY(-2px); box-shadow: 0 8px 18px rgba(124, 58, 237, 0.4); }
        .project-link.outline { background: transparent; color: var(--accent); border: 1.5px solid var(--accent); }
        .project-link.outline:hover { background: var(--accent); color: #fff; }

        /* ====== Hobbies ====== */
        .hobbies-row { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center; }
        .hobby-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.7rem 1.4rem;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 999px;
            color: var(--text-primary);
            font-size: 0.95rem;
            backdrop-filter: blur(8px);
            transition: all 0.25s;
        }
        .hobby-chip:hover { border-color: var(--accent); transform: translateY(-3px); }
        .hobby-chip i { color: var(--accent); }

        /* ====== Contact ====== */
        #contact { padding: 0 2rem 4rem; max-width: 1200px; margin: 0 auto; }
        .contact-card {
            background: var(--contact-gradient);
            color: #fff;
            border-radius: 24px;
            padding: 3rem;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2.5rem;
            box-shadow: 0 18px 44px rgba(124, 58, 237, 0.4);
            position: relative;
            overflow: hidden;
        }
        .contact-card::before {
            content: '';
            position: absolute;
            top: -50%; right: -10%;
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(255,255,255,0.1), transparent 70%);
            pointer-events: none;
        }
        .contact-info h2 { color: #fff; font-family: 'Space Grotesk', sans-serif; font-size: 2rem; margin-bottom: 1rem; }
        .contact-info > p { color: rgba(255,255,255,0.9); margin-bottom: 1.6rem; line-height: 1.7; }
        .contact-item { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.2rem; }
        .contact-item i { font-size: 1.2rem; width: 26px; color: #fff; }
        .contact-item h4 { color: #fff; font-size: 0.85rem; opacity: 0.8; margin-bottom: 0.2rem; }
        .contact-item p  { color: #fff; font-size: 1rem; }
        .social-row { display: flex; gap: 0.8rem; margin-top: 1.5rem; }
        .social-row a {
            display: flex; align-items: center; justify-content: center;
            width: 44px; height: 44px;
            border-radius: 50%;
            background: rgba(255,255,255,0.15);
            color: #fff;
            text-decoration: none;
            font-size: 1.2rem;
            transition: all 0.25s;
        }
        .social-row a:hover { background: rgba(255,255,255,0.3); transform: translateY(-3px); }

        .contact-form { position: relative; z-index: 2; }
        .form-group { margin-bottom: 1.1rem; }
        .form-group label { display: block; color: #fff; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.9rem; }
        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 0.85rem 1rem;
            border: none;
            border-radius: 10px;
            background: var(--form-input-bg);
            color: var(--form-input-fg);
            font-family: inherit;
            font-size: 0.95rem;
            backdrop-filter: blur(6px);
            transition: all 0.2s;
        }
        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            background: var(--form-input-bg);
            box-shadow: 0 0 0 3px rgba(255,255,255,0.3);
        }
        .form-group textarea { min-height: 110px; resize: vertical; }
        .submit-btn {
            width: 100%;
            padding: 0.9rem;
            background: rgba(255,255,255,0.18);
            color: #fff;
            border: 2px solid #fff;
            border-radius: 10px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.25s;
            display: flex; align-items: center; justify-content: center; gap: 0.5rem;
        }
        .submit-btn:hover { background: #fff; color: var(--accent-2); transform: translateY(-2px); }

        /* ====== Footer ====== */
        footer {
            text-align: center;
            padding: 2rem;
            background: var(--footer-bg);
            color: var(--text-muted);
            font-size: 0.9rem;
            border-top: 1px solid var(--card-border);
        }

        /* More editorial spacing and contrast for recruiter-friendly scanning. */
        .hero { min-height: 88vh; padding-top: 128px; }
        .hero-content { max-width: 860px; }
        .hero h1 { font-size: clamp(3rem, 8vw, 6.4rem); letter-spacing: -0.055em; line-height: 0.98; }
        .section { padding: 92px 2rem; }
        .section-title { font-size: clamp(1.7rem, 3vw, 2.35rem); letter-spacing: -0.02em; }
        .project-card, .experience-card, .about-card, .contact-card {
            box-shadow: var(--card-shadow);
        }
        .project-card, .experience-card { border-radius: 16px; }
        /* Refined palette: preserve Aurora's identity without letting effects lead. */
        :root[data-theme="dark"] {
            --bg-page: #10131a;
            --bg-section: #141922;
            --text-secondary: #d7dce5;
            --text-muted: #aab3c2;
            --card-bg: #171d27;
            --card-border: rgba(215, 220, 229, 0.14);
            --nav-bg: rgba(16, 19, 26, 0.96);
            --gradient-soft: linear-gradient(135deg, #151927 0%, #10131a 100%);
            --accent: #b7a7ee;
            --accent-2: #806bbf;
            --gradient-1: linear-gradient(135deg, #b7a7ee 0%, #806bbf 100%);
        }
        :root[data-theme="light"] {
            --text-secondary: #334155;
            --text-muted: #526179;
            --card-bg: #ffffff;
            --card-border: rgba(51, 65, 85, 0.16);
            --nav-bg: rgba(250, 249, 255, 0.96);
        }
        .bg-animation { opacity: 0.08; }
        .floating-element { animation: none; opacity: 0.08 !important; text-shadow: none; }
        nav { backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
        .hero {
            min-height: 68vh;
            padding: 104px 2rem 58px;
        }
        .hero h1 .accent-text,
        .section-title {
            background: none;
            -webkit-text-fill-color: currentColor;
            color: var(--text-primary);
        }
        .hero h1 .accent-text { color: var(--accent); }
        .hero-eyebrow, .hero-socials a, .about-card, .skill-card, .timeline-item,
        .project-card, .contact-card {
            backdrop-filter: none;
            -webkit-backdrop-filter: none;
        }
        .hero-socials a { background: transparent; }
        .about-card, .skill-card, .timeline-item, .project-card, .contact-card {
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16);
        }
        .btn-primary { background: var(--accent-2); box-shadow: none; }
        .btn-primary:hover { box-shadow: none; }
        .section { padding: 72px 2rem; }
        @media (max-width: 860px) {
            .hero { min-height: 70vh; padding-top: 96px; }
            .section { padding: 66px 1.2rem; }
        }
        @media (max-width: 600px) {
            .hero { min-height: 64vh; padding: 88px 1.2rem 44px; }
            .section { padding: 54px 1.2rem; }
        }

        /* ====== Responsive ====== */
        @media (max-width: 860px) {
            .nav-links { display: none; position: absolute; top: 70px; left: 0; right: 0;
                         background: var(--nav-bg); flex-direction: column; padding: 1.5rem 2rem;
                         border-bottom: 1px solid var(--card-border); backdrop-filter: blur(18px); }
            .nav-links.open { display: flex; }
            .menu-btn { display: block; }
            .about-card, .contact-card { grid-template-columns: 1fr; padding: 2rem; }
            .section { padding: 70px 1.2rem; }
        }
    </style>
</head>
<body>
    <div class="bg-animation" id="bgAnimation" aria-hidden="true"></div>

    <!-- ====== Navigation ====== -->
    <nav>
        <div class="nav-container">
            <div class="logo">{{ Name or "Portfolio" }}</div>
            <ul class="nav-links" id="navLinks">
                <li><a href="#home">Home</a></li>
                {% if About %}<li><a href="#about">About</a></li>{% endif %}
                {% if SkillsGrouped and SkillsGrouped|length > 0 %}<li><a href="#skills">Skills</a></li>{% endif %}
                {% if Experience and Experience|length > 0 %}<li><a href="#experience">Experience</a></li>{% endif %}
                {% if Projects and Projects|length > 0 %}<li><a href="#projects">Projects</a></li>{% endif %}
                <li><a href="#contact">Contact</a></li>
            </ul>
            <div class="nav-actions">
                <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme" title="Toggle dark / light">
                    <i class="fa-solid fa-moon"></i>
                    <i class="fa-solid fa-sun"></i>
                </button>
                <button class="menu-btn" id="menuBtn" aria-label="Menu"><i class="fa-solid fa-bars"></i></button>
            </div>
        </div>
    </nav>

    <!-- ====== Hero ====== -->
    <section id="home" class="hero">
        <div class="hero-content">
            <div class="hero-eyebrow"><span class="dot"></span> Available for Opportunities</div>
            <h1>Hi, I'm <span class="accent-text">{{ Name or "Your Name" }}</span></h1>
            {% if Introduction %}
            <h2>{{ Introduction }}</h2>
            {% endif %}
            {% if About %}
            <p class="bio">{{ About }}</p>
            {% endif %}
            <div class="hero-buttons">
                {% if Email %}<a href="mailto:{{ Email }}" class="btn btn-primary"><i class="fa-solid fa-envelope"></i> Get In Touch</a>{% endif %}
                {% if Projects and Projects|length > 0 %}<a href="#projects" class="btn btn-outline"><i class="fa-solid fa-rocket"></i> View My Work</a>{% endif %}
            </div>
            <div class="hero-socials">
                {% if Github %}<a href="{{ Github }}" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-github"></i> GitHub</a>{% endif %}
                {% if Linkedin %}<a href="{{ Linkedin }}" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-linkedin"></i> LinkedIn</a>{% endif %}
                {% if Portfolio_URL %}<a href="{{ Portfolio_URL }}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-globe"></i> Portfolio</a>{% endif %}
                {% if Twitter %}<a href="{{ Twitter }}" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-x-twitter"></i> Twitter</a>{% endif %}
                {% if Phone %}<a href="tel:{{ Phone|replace(' ', '') }}"><i class="fa-solid fa-phone"></i> {{ Phone }}</a>{% endif %}
            </div>
        </div>
    </section>

    <!-- ====== About ====== -->
    {% if About or (Education and Education|length > 0) %}
    <section id="about" class="section">
        <h2 class="section-title">About Me</h2>
        <div class="about-card">
            <div class="about-text">
                {% if About %}
                <h3>Hello! I'm {{ Name or "a developer" }}</h3>
                {% for para in About.split('\n') if para.strip() %}
                <p>{{ para.strip() }}</p>
                {% endfor %}
                {% else %}
                <h3>Hello! I'm {{ Name or "a developer" }}</h3>
                <p>Welcome to my personal portfolio. I'm passionate about building great things and learning new technologies.</p>
                {% endif %}
            </div>
            {% if Education and Education|length > 0 %}
            <div class="edu-card">
                <h3><i class="fa-solid fa-graduation-cap"></i> Education</h3>
                {% set edu = Education[0] %}
                {% if edu.degree %}<p><strong>{{ edu.degree }}</strong></p>{% endif %}
                {% if edu.institution %}<p>{{ edu.institution }}</p>{% endif %}
                {% if edu.years %}<p>{{ edu.years }}</p>{% endif %}
                {% if edu.gpa %}<p>Score: {{ edu.gpa }}</p>{% endif %}
            </div>
            {% endif %}
        </div>
    </section>
    {% endif %}

    <!-- ====== Skills ====== -->
    {% if (SkillsGrouped and SkillsGrouped|length > 0) or (Skills and Skills|length > 0) %}
    <section id="skills" class="section">
        <h2 class="section-title">Skills & Technologies</h2>
        <div class="skills-grid">
            {% if SkillsGrouped and SkillsGrouped|length > 0 %}
                {% for cat in SkillsGrouped %}
                <div class="skill-card">
                    <div class="icon"><i class="fa-solid fa-layer-group"></i></div>
                    <h3>{{ cat.category }}</h3>
                    <div class="skill-pills">
                        {% for s in cat.skills %}<span class="skill-pill">{{ s }}</span>{% endfor %}
                    </div>
                </div>
                {% endfor %}
            {% elif Skills and Skills|length > 0 %}
                <div class="skill-card">
                    <div class="icon"><i class="fa-solid fa-bolt"></i></div>
                    <h3>Tech Stack</h3>
                    <div class="skill-pills">
                        {% for s in Skills %}<span class="skill-pill">{{ s }}</span>{% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
    </section>
    {% endif %}

    <!-- ====== Experience ====== -->
    {% if Experience and Experience|length > 0 %}
    <section id="experience" class="section">
        <h2 class="section-title">Experience & Internships</h2>
        <div class="timeline">
            {% for exp in Experience %}
            <div class="timeline-item">
                <h4>{{ exp.role or "Role" }}</h4>
                {% if exp.company %}<div class="company">{{ exp.company }}</div>{% endif %}
                {% if exp.dates %}<div class="dates">{{ exp.dates }}</div>{% endif %}
                {% if exp.description %}<p>{{ exp.description }}</p>{% endif %}
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <!-- ====== Projects ====== -->
    {% if Projects and Projects|length > 0 %}
    <section id="projects" class="section">
        <h2 class="section-title">My Projects</h2>
        <div class="projects-grid">
            {% for project in Projects %}
            <div class="project-card">
                <h3>{{ project.title }}</h3>
                {% if project.description %}<p>{{ project.description }}</p>{% endif %}

                {% if project['items'] and project['items']|length > 0 %}
                <ul>
                    {% for b in project['items'] %}<li>{{ b }}</li>{% endfor %}
                </ul>
                {% endif %}

                {% if project['tech_stack'] and project['tech_stack']|length > 0 %}
                <div class="tech-tags">
                    {% for tag in project['tech_stack'] %}<span class="tech-tag">{{ tag }}</span>{% endfor %}
                </div>
                {% endif %}

                {% if project['github_url'] or project['live_url'] %}
                <div class="project-links">
                    {% if project['github_url'] %}
                    <a href="{{ project['github_url'] }}" target="_blank" rel="noopener noreferrer" class="project-link outline">
                        <i class="fa-brands fa-github"></i> View Code
                    </a>
                    {% endif %}
                    {% if project['live_url'] %}
                    <a href="{{ project['live_url'] }}" target="_blank" rel="noopener noreferrer" class="project-link">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i> Live Demo
                    </a>
                    {% endif %}
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <!-- ====== Hobbies ====== -->
    {% if Hobbies and Hobbies|length > 0 %}
    <section class="section" id="hobbies">
        <h2 class="section-title">Beyond Code</h2>
        <div class="hobbies-row">
            {% for hobby in Hobbies %}
            <div class="hobby-chip"><i class="fa-solid fa-star"></i> {{ hobby }}</div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <!-- ====== Contact ====== -->
    <section id="contact">
        <div class="contact-card">
            <div class="contact-info">
                <h2>Get In Touch</h2>
                <p>Have a project in mind, want to collaborate, or just want to say hi? I'd love to hear from you!</p>

                {% if Email %}
                <div class="contact-item">
                    <i class="fa-solid fa-envelope"></i>
                    <div>
                        <h4>EMAIL</h4>
                        <p><a href="mailto:{{ Email }}" style="color:#fff; text-decoration:none;">{{ Email }}</a></p>
                    </div>
                </div>
                {% endif %}
                {% if Phone %}
                <div class="contact-item">
                    <i class="fa-solid fa-phone"></i>
                    <div>
                        <h4>PHONE</h4>
                        <p>{{ Phone }}</p>
                    </div>
                </div>
                {% endif %}
                {% if Github or Linkedin or Twitter or Portfolio_URL %}
                <h4 style="margin-top: 1.5rem; margin-bottom: 0.5rem; color:#fff; font-size:0.85rem; opacity:0.8;">FOLLOW ME</h4>
                <div class="social-row">
                    {% if Github %}<a href="{{ Github }}" target="_blank" rel="noopener noreferrer" title="GitHub"><i class="fa-brands fa-github"></i></a>{% endif %}
                    {% if Linkedin %}<a href="{{ Linkedin }}" target="_blank" rel="noopener noreferrer" title="LinkedIn"><i class="fa-brands fa-linkedin"></i></a>{% endif %}
                    {% if Twitter %}<a href="{{ Twitter }}" target="_blank" rel="noopener noreferrer" title="Twitter / X"><i class="fa-brands fa-x-twitter"></i></a>{% endif %}
                    {% if Portfolio_URL %}<a href="{{ Portfolio_URL }}" target="_blank" rel="noopener noreferrer" title="Portfolio"><i class="fa-solid fa-globe"></i></a>{% endif %}
                </div>
                {% endif %}
            </div>

            <form class="contact-form" onsubmit="event.preventDefault(); this.querySelector('.submit-btn').innerHTML='<i class=\'fa-solid fa-check\'></i> Message Sent!'; this.reset();">
                <div class="form-group">
                    <label for="name">Your Name</label>
                    <input type="text" id="name" name="name" placeholder="Jane Doe" required>
                </div>
                <div class="form-group">
                    <label for="email">Your Email</label>
                    <input type="email" id="email" name="email" placeholder="jane@example.com" required>
                </div>
                <div class="form-group">
                    <label for="subject">Subject</label>
                    <input type="text" id="subject" name="subject" placeholder="Project inquiry">
                </div>
                <div class="form-group">
                    <label for="message">Message</label>
                    <textarea id="message" name="message" placeholder="Hello, I'd like to talk about..." required></textarea>
                </div>
                <button type="submit" class="submit-btn"><i class="fa-solid fa-paper-plane"></i> Send Message</button>
            </form>
        </div>
    </section>

    <footer>
        <p>© {{ "" if not Name else "" }} {{ Name or "Portfolio" }} — Built with AI Portfolio Maker</p>
    </footer>

    <script>
        // ====== Theme toggle with persistence ======
        (function() {
            const root = document.documentElement;
            const saved = localStorage.getItem('portfolio-theme') || 'dark';
            root.setAttribute('data-theme', saved);

            document.getElementById('themeToggle').addEventListener('click', () => {
                const current = root.getAttribute('data-theme');
                const next = current === 'dark' ? 'light' : 'dark';
                root.setAttribute('data-theme', next);
                localStorage.setItem('portfolio-theme', next);
            });

            // Mobile menu
            const menuBtn = document.getElementById('menuBtn');
            const navLinks = document.getElementById('navLinks');
            menuBtn.addEventListener('click', () => navLinks.classList.toggle('open'));
            document.querySelectorAll('.nav-links a').forEach(a => a.addEventListener('click', () => navLinks.classList.remove('open')));
        })();

        // ====== 3D Animated Code Background ======
        (function() {
            const bg = document.getElementById('bgAnimation');
            const items = [
                '101', '110', '01', '10', '111', '001', '1001', '1100', '0101', '1010',
                '{', '}', '[', ']', '(', ')', '<', '>', '/', '*', '=', '!=', '&&', '||',
                'if', 'else', 'for', 'while', 'return', 'class', 'const', 'let', 'var',
                'function', 'import', 'export', 'await', 'async', 'new', 'try', 'catch',
                'userName', 'password', 'data', 'result', 'count', 'value', 'status',
                'HTML', 'CSS', 'JS', 'SQL', 'API', 'JSON', 'Python', 'Java',
                'push()', 'pop()', 'map()', 'filter()', 'split()', 'join()',
                'SELECT', 'INSERT', 'UPDATE', 'DELETE', 'WHERE', 'FROM'
            ];
            const keywords = new Set(['if','else','for','while','function','class','var','let','const','return','import','export','await','async','new','try','catch']);
            const variables = new Set(['userName','password','data','result','count','value','status']);

            function make() {
                const el = document.createElement('div');
                el.className = 'floating-element';
                const text = items[Math.floor(Math.random() * items.length)];
                el.textContent = text;
                el.style.left = (Math.random() * 100) + '%';
                el.style.animationDelay = (Math.random() * 18) + 's';
                el.style.fontSize = (Math.random() * 12 + 16) + 'px';

                if (/^[01]+$/.test(text))                              el.classList.add('binary');
                else if (/^\d+$/.test(text))                           el.classList.add('number');
                else if (['{','}','[',']','(',')','<','>'].includes(text)) el.classList.add('bracket');
                else if (keywords.has(text))                           el.classList.add('keyword');
                else if (variables.has(text))                          el.classList.add('variable');
                else                                                   el.classList.add('code-sym');

                bg.appendChild(el);
                setTimeout(() => el.remove(), 42000);
            }
            setInterval(make, 700);
            for (let i = 0; i < 6; i++) setTimeout(make, i * 400);
        })();
    </script>
</body>
</html>
